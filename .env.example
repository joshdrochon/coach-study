# Copy to .env.local and fill in. Never commit real values.

# Database: a Postgres URL, or an in-process PGlite database for local work.
DATABASE_URL=pglite://.pglite-dev

# The learner passcode (4 digits), the admin passcode (16+ characters) and the cookie signing
# secret (32+ characters).
APP_PASSCODE=
ADMIN_PASSCODE=
SESSION_SECRET=

# Claude grades spoken and typed answers. Without a key the app cannot grade.
ANTHROPIC_API_KEY=

# Optional: the app's voice (ElevenLabs). Without a key every line uses the device's own voice.
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=
# Characters a day the voice may send (default 40000).
TTS_DAILY_CHARS=

# Optional: daily study reminders (web push).
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:you@example.com
NUDGE_SECRET=
