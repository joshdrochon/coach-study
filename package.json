{
  "name": "coach-study-demo",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.27.0",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "tsx scripts/db/dev-guard.ts && next dev --port 3000",
    "build": "next build",
    "start": "next start --port 3000",
    "lint": "eslint . --max-warnings=0 --cache --cache-location node_modules/.cache/eslint/",
    "typecheck": "next typegen && tsc --noEmit",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "prepare": "husky",
    "sound:synth": "tsx scripts/sound/synth.ts",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx scripts/db/migrate.ts",
    "db:export": "tsx scripts/db/export.ts",
    "db:restore": "tsx scripts/db/restore.ts",
    "db:size": "tsx scripts/db/size.ts",
    "db:prune-clips": "tsx --conditions=react-server scripts/db/prune-clips.ts",
    "db:wipe-progress": "tsx scripts/db/wipe-progress.ts",
    "tokens": "tsx scripts/design/gen-tokens.ts",
    "icons": "tsx scripts/design/gen-icons.ts",
    "fonts": "bash scripts/fonts/get-switzer.sh"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "0.131.0",
    "@neondatabase/serverless": "1.1.0",
    "double-metaphone": "2.0.1",
    "drizzle-orm": "0.45.3",
    "next": "16.4.6",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "server-only": "0.0.1",
    "ts-fsrs": "5.4.2",
    "web-push": "3.6.7",
    "zod": "4.6.7"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild",
      "sharp",
      "unrs-resolver"
    ]
  },
  "devDependencies": {
    "@electric-sql/pglite": "0.5.8",
    "@types/node": "24.19.0",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@types/web-push": "3.6.4",
    "@vitest/coverage-v8": "5.0.3",
    "drizzle-kit": "0.31.11",
    "eslint": "9.39.5",
    "eslint-config-next": "16.4.6",
    "eslint-config-prettier": "10.1.8",
    "husky": "9.1.7",
    "lint-staged": "17.6.0",
    "prettier": "3.9.9",
    "tsx": "4.23.15",
    "typescript": "6.0.3",
    "typescript-eslint": "8.71.0",
    "vitest": "5.0.3"
  }
}
